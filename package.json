{
  "name": "qiankun-example",
  "version": "1.0.0",
  "private": true,
  "description": "开箱即用的多框架微前端教学工作台",
  "workspaces": [
    "main",
    "sub-vue",
    "sub-react",
    "sub-html",
    "common"
  ],
  "engines": {
    "node": ">=22.14 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "npm run dev",
    "build": "node scripts/build.cjs",
    "preview": "node scripts/preview.cjs",
    "check": "node --test tests/*.test.cjs",
    "test": "npm run check && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.cjs",
    "setup:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "@playwright/test": "^1.56.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "2.7.16",
    "webpack": "^5.102.0",
    "webpack-dev-server": "^5.2.2"
  },
  "license": "MIT"
}
