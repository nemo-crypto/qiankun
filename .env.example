# 可直接使用默认值，无需复制本文件。自定义时复制为根目录 .env。
HOST=127.0.0.1
MAIN_PORT=8080
VUE_PORT=7777
REACT_PORT=7788
HTML_PORT=7799
PREVIEW_PORT=4173
# 留空时开发环境按当前访问主机名 + 子应用端口生成地址。
# 生产环境默认从 /subapp/{应用名}/ 加载，无外部域名依赖。
# VUE_APP_SUB_VUE=https://your-cdn.example/sub-vue/
# VUE_APP_SUB_REACT=https://your-cdn.example/sub-react/
# VUE_APP_SUB_HTML=https://your-cdn.example/sub-html/
